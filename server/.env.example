# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Database name must be "jobFinder" (capital F).
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/jobFinder

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email Notifications (optional) ───────────────────────────────────────────
# If these are omitted, email digests are silently skipped — the app still works.
# Works with any SMTP provider: Gmail App Passwords, Resend, Mailgun, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password   (not your Gmail password — use an App Password)
#   SMTP_FROM=you@gmail.com
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx
#   SMTP_FROM=notifications@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
